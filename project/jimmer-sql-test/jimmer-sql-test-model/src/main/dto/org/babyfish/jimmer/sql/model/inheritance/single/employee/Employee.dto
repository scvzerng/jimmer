/*
 * Employee 的 polymorphic DTO(single-table 继承)。
 *
 * 这个 DTO 专门测试 **"同名 prop 不同投影"** 场景:
 * `supervisor` 不在根级声明,而是在每个 branch 内各自声明,
 * 且两个 branch 投影的 supervisor 字段集不同:
 *
 *   - FullTimeEmployee.supervisor 投影 { id, fullName, department { id, name, location } }
 *   - PartTimeEmployee.supervisor 投影 { id, fullName }  (不投影 department)
 *
 * jimmer-apt 会为两个 branch 生成**字段集不同**的 `TargetOf_supervisor`
 * inner DTO 类,运行时各自发独立 batch fetch SQL。
 * 这是 polymorphic DTO 的 per-branch 灵活投影能力的核心验证。
 *
 * 标量属性(每个子类型共享):
 *   - id, fullName, type
 *
 * FullTimeEmployee 分支专属:
 *   - annualSalary (分支标量)
 *   - supervisor (1-level, ManyToOne) -> department (2-level)
 *   - responsibilities (1-level, OneToMany) -> project (2-level)
 *
 * PartTimeEmployee 分支专属:
 *   - hourlyRate (分支标量)
 *   - supervisor (1-level, 不投影 department)
 *   - responsibilities (1-level, OneToMany) -> project (2-level)
 */
EmployeeOverview {
    id
    fullName
    type
    #types {
        #exhaustive
        FullTimeEmployee {
            annualSalary
            supervisor {
                id
                fullName
                department {
                    id
                    name
                    location
                }
            }
            responsibilities {
                id
                title
                project {
                    id
                    name
                    client
                }
            }
        }
        PartTimeEmployee {
            hourlyRate
            supervisor {
                id
                fullName
            }
            responsibilities {
                id
                title
                project {
                    id
                    name
                    client
                }
            }
        }
    }
}

input EmployeeInput {
    id
    fullName
    type
    #types {
        #exhaustive
        FullTimeEmployee {
            annualSalary
            supervisor {
                id
                fullName
                department {
                    id
                    name
                    location
                }
            }
            responsibilities {
                id
                title
                project {
                    id
                    name
                    client
                }
            }
        }
        PartTimeEmployee {
            hourlyRate
            supervisor {
                id
                fullName
            }
            responsibilities {
                id
                title
                project {
                    id
                    name
                    client
                }
            }
        }
    }
}

/*
 * 回归测试: 嵌套 polymorphic DTO input + 根属性含 id-only 关联引用 (id(xxx))
 *
 * 用于在 jimmer-apt 跟 jimmer-ksp 两条路径上验证嵌套 polymorphic input
 * 的 override 行为。跟 jimmer-ksp 的 Employee.dto 是同源用例,只是
 * 在 jimmer-apt 这边独立测试,看 apt 是否也漏掉嵌套 polymorphic input
 * 内部 prop (id(supervisor)/id(department)) 的 override 处理。
 */
input EmployeeWithNestedIdOnlyRefInput {
    id
    fullName
    type

    // 嵌套 polymorphic DTO input: supervisor 既是 polymorphic 关联,
    // 根属性又含 id(supervisor) + id(department) 两个 id-only 引用
    supervisor {
        id
        fullName
        type
        id(supervisor)   // 根属性: self-reference id-only 引用
        id(department)   // 根属性: ManyToOne id-only 引用
        #types {
            FullTimeEmployee {}
            PartTimeEmployee {}
        }
    }

    #types {
        #exhaustive
        FullTimeEmployee {
            annualSalary
        }
        PartTimeEmployee {
            hourlyRate
        }
    }
}
